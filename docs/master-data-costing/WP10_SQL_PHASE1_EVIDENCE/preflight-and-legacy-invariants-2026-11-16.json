  "read_only_query": "begin read only;\nset local statement_timeout = '8s';\nwith started as materialized (select clock_timestamp() as t, costing.fn_wp10_today_ist() as day),\nsample as materialized (\n select s.id as sku_id,s.product_id,p.sub_group_id from public.product_skus s join public.products p on p.id=s.product_id\n where s.is_active and p.status='Active' and not coalesce(s.is_sample,false) order by s.id limit 10),\nevaluated as materialized (\n select s.sku_id,s.product_id,\n costing.fn_wp10_essential_states_as_of(s.sku_id,s.product_id,t.day) as essentials,\n costing.fn_wp10_route_state_ctx(s.product_id::integer,t.day,s.sub_group_id) as route,\n costing.fn_wp10_boundary_dates(s.sku_id,s.product_id,t.day,t.day+30) as boundaries\n from sample s cross join started t)\nselect jsonb_build_object(\n'transaction_read_only',current_setting('transaction_read_only'),\n'statement_timeout',current_setting('statement_timeout'),\n'date_ist',(select day from started),\n'sampled_skus',(select count(*) from evaluated),\n'sampled_products',(select count(distinct product_id) from evaluated),\n'essential_results',(select jsonb_agg(jsonb_build_object('code',key,'state',value,'count',n) order by key,value) from (select kv.key,kv.value,count(*) n from evaluated e cross join lateral jsonb_each_text(e.essentials) kv group by kv.key,kv.value) z),\n'route_results',(select jsonb_object_agg(state,n) from (select route->>'state' as state,count(*) n from evaluated group by route->>'state') z),\n'boundary_dates_total',(select sum(cardinality(boundaries)) from evaluated),\n'well_formed',(select bool_and(essentials ?& array['PM_BOM_REVISION','BATCH_SIZE_REFERENCE','MANUFACTURING_ROUTE','MRP_POLICY','SELLING_PRICE_POLICY'] and not exists(select 1 from jsonb_each_text(essentials) x where x.value not in ('RESOLVED','MISSING','AMBIGUOUS','UNKNOWN')) and route->>'state' in ('VALID','INVALID','UNKNOWN') and cardinality(boundaries)<=30) from evaluated),\n'negative_control',costing.fn_wp10_route_state_ctx(null,(select day from started),null),\n'batch_elapsed_ms',round(extract(epoch from clock_timestamp()-(select t from started))*1000,3)\n) as readonly_checks;\ncommit;",
